{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(terraform test*)",
      "Bash(tflint*)",
      "Bash(checkov*)",
      "Bash(gitleaks*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws * get-*)",
      "PowerShell(terraform fmt*)",
      "PowerShell(terraform validate*)",
      "PowerShell(terraform init*)",
      "PowerShell(terraform plan*)",
      "PowerShell(terraform test*)",
      "PowerShell(tflint*)",
      "PowerShell(checkov*)",
      "PowerShell(gitleaks*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(aws sts get-caller-identity*)",
      "PowerShell(aws * describe-*)",
      "PowerShell(aws * list-*)",
      "PowerShell(aws * get-*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(git push*)",
      "Bash(gh repo create*)",
      "Bash(gh api*-X PATCH*)",
      "Bash(gh api*-X POST*)",
      "Bash(gh api*-X PUT*)",
      "Bash(gh api*--method*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws ssm get-parameter*)",
      "Bash(aws sts get-session-token*)",
      "Bash(aws sts get-federation-token*)",
      "PowerShell(terraform apply*)",
      "PowerShell(terraform -chdir=* apply*)",
      "PowerShell(terraform destroy*)",
      "PowerShell(terraform -chdir=* destroy*)",
      "PowerShell(git push*)",
      "PowerShell(gh repo create*)",
      "PowerShell(gh api*-X PATCH*)",
      "PowerShell(gh api*-X POST*)",
      "PowerShell(gh api*-X PUT*)",
      "PowerShell(gh api*--method*)",
      "PowerShell(aws secretsmanager get-secret-value*)",
      "PowerShell(aws ssm get-parameter*)",
      "PowerShell(aws sts get-session-token*)",
      "PowerShell(aws sts get-federation-token*)"
    ],
    "deny": [
      "Bash(terraform*-auto-approve*)",
      "Bash(aws*iam create-access-key*)",
      "Bash(aws*iam create-user*)",
      "PowerShell(terraform*-auto-approve*)",
      "PowerShell(aws*iam create-access-key*)",
      "PowerShell(aws*iam create-user*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.json)",
      "Write(.claude/settings.local.json)"
    ]
  }
}
