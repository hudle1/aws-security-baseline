# Copy to baseline.tfvars (gitignored) and fill in real values.
# Use with: terraform plan "-var-file=baseline.tfvars" "-out=baseline.tfplan"
account_id = "123456789012"

# Optional (defaults shown)
# trail_name                = "baseline-trail"
# log_retention_days        = 365
# noncurrent_retention_days = 30

# Where real-time security alerts are sent (SNS email). Terraform creates the
# subscription as "pending"; you must click the confirmation link in the email.
alert_email = "you@example.com"
